      "name": "two questions, none picked",
      "session": { "provider": "claude", "project": "web", "name": "web" },
      "ask": {
        "tool": "AskUserQuestion", "detail": "", "offersAlways": false,
        "questions": [
          { "question": "Color?", "multiSelect": false, "options": [{ "label": "Red" }] },

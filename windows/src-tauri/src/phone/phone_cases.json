      "session": { "provider": "claude", "project": "web", "name": "web" },
      "ask": { "tool": "Bash", "detail": "rm -rf build", "offersAlways": true },
      "hideCode": false,
      "text": "<b>Claude Code</b> · web\n\nWants to run a command.\n\n<pre>rm -rf build</pre>",
      "buttons": [["Deny", "Always", "Allow"]]
    },
    {
      "name": "escaped command in a named session",
      "session": { "provider": "claude", "project": "web", "name": "Fix login" },
      "ask": { "tool": "Bash", "detail": "echo '<a>' && ls", "offersAlways": false },
      "hideCode": false,
      "text": "<b>Claude Code</b> · web\n<i>Fix login</i>\n\nWants to run a command.\n\n<pre>echo '&lt;a&gt;' &amp;&amp; ls</pre>",

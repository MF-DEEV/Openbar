{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "0.5.0",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "shortDescription": "Dynamic Island for Linux",
    "linux": {
      "deb": {
        "section": "utils",
        "recommends": [
          "pulseaudio-utils",
          "tesseract-ocr",
          "ffmpeg",
          "libsqlite3-0",
          "libgtk-layer-shell0",
          "wl-clipboard",
          "grim",
          "wtype",
          "wf-recorder"
        ]
      },
      "rpm": {
        "recommends": [
          "pulseaudio-utils",
          "tesseract",
          "ffmpeg-free",
          "sqlite-libs",
          "gtk-layer-shell",
          "wl-clipboard",
          "grim",
          "wtype",
          "wf-recorder"
        ]
      }
    }
  }
}

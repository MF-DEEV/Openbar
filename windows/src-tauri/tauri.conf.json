{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openbar",
  "version": "0.4.0",
  "identifier": "com.openbar.island",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "MF DEV",
    "copyright": "Copyright (C) 2026 MF DEV, Adrian and the Openbar contributors. Based on Vorssaint, Copyright (C) 2026 Vorssaint. GPL-3.0-or-later.",
    "shortDescription": "Dynamic Island for Windows",
    "longDescription": "A Dynamic Island at the top of your screen: music, notifications, your calendar, and your Claude Code and Codex sessions.",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Openbar",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "mainBinaryName": "Openbar",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDODVCRjlCNTlDRDFERjUKUldUMUhjMVptNytGTEJNcUNKRXJBdGhGRzVPMHZNWm1aa1hSQjVrT1kyMzdyQnVBYzJkbzNhSXoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

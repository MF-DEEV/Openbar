{
  "name": "vorssaint-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:i18n": "vitest run src/i18n/i18n.test.ts",
    "test:i18n-ui": "node scripts/check-island-layout.mjs --i18n",
    "test:island-layout": "node scripts/check-island-layout.mjs",
    "test:island-shortcut": "node scripts/check-island-layout.mjs --island-shortcut",
    "test:context-menu": "node scripts/check-island-layout.mjs --context-menu",
    "test:captures": "node scripts/check-island-layout.mjs --captures",
    "test:music-lyrics": "node scripts/check-island-layout.mjs --music-lyrics",
    "test:settings-select": "node scripts/check-island-layout.mjs --settings",
    "test:quick-access": "node scripts/check-island-layout.mjs --quick-access",
    "test:activity-picker": "node scripts/check-island-layout.mjs --activity-picker",
    "test:session-notice": "node scripts/check-island-layout.mjs --session-notice",
    "test:downloads": "node scripts/check-island-layout.mjs --downloads",
    "test:all-displays": "node scripts/check-island-layout.mjs --all-displays",
    "test:notification-preview": "node scripts/check-island-layout.mjs --notification-preview",
    "test:idle-content": "node scripts/check-island-layout.mjs --idle-content",
    "test:mascot": "node scripts/check-island-layout.mjs --mascot",
    "test:capture-controls": "node scripts/check-island-layout.mjs --capture-controls",
    "test:gestures": "node scripts/check-island-layout.mjs --gestures",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}

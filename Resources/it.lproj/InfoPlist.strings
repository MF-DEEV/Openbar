/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Openbar usa Automazione per spostare file, inviare elementi al Cestino, aprire i comandi richiesti, scrivere le tue risposte nelle sessioni di Claude Code nel Terminale e controllare la riproduzione nelle tue app multimediali.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Openbar usa l'audio di ogni app per regolarne il volume nel mixer, per muovere le barre musicali di Dynamic Island e per includere l'audio del Mac nelle registrazioni dello schermo che avvii. Nulla lascia il tuo Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Openbar usa il Bluetooth solo per leggere la batteria delle periferiche connesse. Nulla lascia il tuo Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Openbar registra il microfono solo quando lo attivi per una registrazione dello schermo. L’audio resta sul tuo Mac, a meno che tu scelga di creare un link temporaneo.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Openbar mostra la fotocamera solo nella finestra di anteprima che apri, così puoi controllare il tuo aspetto prima di una chiamata. Nulla viene registrato e nulla lascia il tuo Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Openbar controlla i metadati locali in Download per esaminare, organizzare o spostare nel Cestino solo i file WhatsApp confermati scelti da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui. Download in Dynamic Island mostra anche i file in arrivo nella cartella Download e nelle cartelle in cui salvano i tuoi browser.";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Openbar organizza i download WhatsApp confermati in una cartella di destinazione scelta esplicitamente da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui. Download in Dynamic Island mostra anche i file in arrivo nella cartella Download e nelle cartelle in cui salvano i tuoi browser.";
